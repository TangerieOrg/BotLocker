DISCORD_TOKEN=
# Registers commands to one guild instantly instead of globally
DEV_GUILD_ID=
# Optional, raises deadlock-api.com rate limits
DEADLOCK_API_KEY=
DATA_DIR=./data
POLL_INTERVAL_MS=120000
MAX_NOTIFY_AGE_H=6
# Only this Discord user can /resetrecord (defaults to the bot application owner)
OWNER_ID=
STEAM_API_KEY=
# How often the bot status rotates between online players
PRESENCE_ROTATE_MS=180000
# Port for the HTTP server
PORT=3030
