DISCORD_TOKEN=
# Registers commands to one guild instantly instead of globally
DEV_GUILD_ID=
# Optional, raises deadlock-api.com rate limits
DEADLOCK_API_KEY=
DATA_DIR=./data
# How often deadlock-api.com is checked for new matches
POLL_INTERVAL_MS=120000
# Backstop poll through the Steam bot, matches are normally picked up as soon as a friend stops playing
GC_POLL_INTERVAL_MS=3600000
MAX_NOTIFY_AGE_H=6
# Only this Discord user can /resetrecord (defaults to the bot application owner)
OWNER_ID=
STEAM_API_KEY=
# How often the bot status rotates between online players
PRESENCE_ROTATE_MS=180000
# Port for the HTTP server
PORT=3030
# Steam account with Deadlock access that friends linked players and pulls their matches from Valve
STEAM_BOT_USERNAME=
STEAM_BOT_PASSWORD=
# Login token printed by deno task steam-test, lets a server log in without a Steam Guard code
STEAM_BOT_REFRESH_TOKEN=
