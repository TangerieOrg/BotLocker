DISCORD_TOKEN=
# Channel wins and losses are announced in, commands are registered to its server
CHANNEL_ID=
DATA_DIR=./data
# Backstop check through the Steam bot, matches are normally picked up as soon as a friend stops playing
GC_POLL_INTERVAL_MS=3600000
MAX_NOTIFY_AGE_H=6
# Only this Discord user can /resetrecord, /adminlink and /steamguard (defaults to the bot application owner)
OWNER_ID=
# Steam accounts with Deadlock access as username|password, comma separated. The first is the main bot: linked players friend it and it pulls their matches from the game coordinator.
# Any others only fetch match salts (each gets its own SALT_FETCH_DAILY_CAP), they may need a /steamguard code on first login. Passwords can't contain a comma.
# Extra accounts only log in for a salt fetch. Add |lazy (username|password|lazy) to a personal account so it also waits until you're not in a game. It must be friends with the main bot
STEAM_USERS='username|password,username|password'
# How often the bot status rotates between online players
PRESENCE_ROTATE_MS=180000
# 0 stops fetching salts from the game coordinator and uploading them to deadlock-api (checks against deadlock-api still run)
SALT_UPLOAD=1
# Wait after a match ends before looking at its salts, so deadlock-api has time to get them itself
SALT_DELAY_MS=1800000
# The game coordinator limits salt fetches hard, at most one per interval and this many per rolling 24h
SALT_FETCH_INTERVAL_MS=1800000
SALT_FETCH_DAILY_CAP=40
# Gap for |lazy personal accounts, their cap scales by SALT_FETCH_INTERVAL_MS / this
SALT_PERSONAL_FETCH_INTERVAL_MS=600000
# Hours an account stops fetching after the game coordinator rate limits it
SALT_RATE_LIMIT_PAUSE_H=30
