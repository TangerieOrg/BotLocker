DISCORD_TOKEN=
# Channel wins and losses are announced in, commands are registered to its server
CHANNEL_ID=
DATA_DIR=./data
# Backstop check through the Steam bot, matches are normally picked up as soon as a friend stops playing
GC_POLL_INTERVAL_MS=3600000
MAX_NOTIFY_AGE_H=6
# Only this Discord user can /resetrecord, /adminlink and /steamguard (defaults to the bot application owner)
OWNER_ID=
# Steam account with Deadlock access, linked players friend it and it pulls their matches from the game coordinator
STEAM_BOT_USERNAME=
STEAM_BOT_PASSWORD=
# How often the bot status rotates between online players
PRESENCE_ROTATE_MS=180000
# 0 stops fetching salts from the game coordinator and uploading them to deadlock-api (checks against deadlock-api still run)
SALT_UPLOAD=1
# Wait after a match ends before looking at its salts, so deadlock-api has time to get them itself
SALT_DELAY_MS=1800000
# The game coordinator limits salt fetches hard, at most one per interval and this many per rolling 24h
SALT_FETCH_INTERVAL_MS=1800000
SALT_FETCH_DAILY_CAP=40
