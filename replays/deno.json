        "@std/dotenv": "jsr:@std/dotenv@^0.225.5",
        "@std/encoding": "jsr:@std/encoding@^1.0.0",
        "@tangerie/remote-sqlite": "jsr:@tangerie/remote-sqlite@^1.3.1",
        "@tangerie/utils": "jsr:@tangerie/utils@^2.13.0",
