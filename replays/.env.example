DATA_DIR=./data
# Port for the read-only remote-sqlite endpoint on the analysis database, 0 turns it off
DB_PORT=8080
# The bot's read-only database endpoint. Prod uses ws://bot:8080 over the compose network
BOTLOCKER_DB_URL=ws://media/botlocker-db
# How often new salts are pulled from the bot
POLL_INTERVAL_MS=300000
# Metadata downloads in flight at once
INGEST_CONCURRENCY=2
# Only read by the CLIs (deno task dead / heatmap), --db overrides it. A plain path opens a local copy
REPLAYS_DB_URL=ws://media/botlocker-replays
